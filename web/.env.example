# Set on Railway → neotalab-web, then redeploy (baked in at build)
NEXT_PUBLIC_API_URL=https://YOUR-API.up.railway.app/api/v1

# Local development: copy to .env.local
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8001/api/v1

# Public business identity (homepage, privacy policy, terms). Must match the documents used for
# Meta Business Verification. Set on Railway → NeoTalab-Web → Variables, then redeploy.
NEXT_PUBLIC_COMPANY_LEGAL_NAME=
NEXT_PUBLIC_COMPANY_ADDRESS=
NEXT_PUBLIC_COMPANY_COUNTRY=Lebanon
NEXT_PUBLIC_CONTACT_EMAIL=support@neotalab.com
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_WHATSAPP=
NEXT_PUBLIC_SITE_URL=https://neotalab.com
# Meta Business Settings → Brand safety → Domains → meta-tag option (content value only)
NEXT_PUBLIC_FB_DOMAIN_VERIFICATION=
# Google Search Console → HTML tag option (content value only)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Google Analytics 4 measurement ID (G-XXXXXXX); loaded only after the visitor accepts cookies
NEXT_PUBLIC_GA_MEASUREMENT_ID=
