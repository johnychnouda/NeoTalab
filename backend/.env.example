APP_NAME=NeoTalab
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8001
FRONTEND_URL=http://localhost:3001

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local MySQL: create a `neotalab` database first. DB_SOCKET is only needed when your MySQL
# listens on a socket instead of the port.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=neotalab
DB_USERNAME=root
DB_PASSWORD=
DB_SOCKET=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# AI conversation engine (M3). Use "fake" for local/tests; "openai" for OpenAI-compatible APIs.
AI_DRIVER=fake
OPENAI_API_KEY=
# Optional: live driving times for delivery estimates (Google Maps Platform, Routes API).
GOOGLE_MAPS_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=30

# WhatsApp Cloud API (required in production)
# Create one Meta app for NeoTalab. Register webhook: {APP_URL}/api/v1/webhooks/whatsapp
WHATSAPP_APP_SECRET=
WHATSAPP_META_APP_ID=
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=
WHATSAPP_VERIFY_TOKEN=neotalab-verify
WHATSAPP_PLATFORM_ACCESS_TOKEN=
WHATSAPP_GRAPH_VERSION=v26.0
# Set false only for local webhook testing without signature
WHATSAPP_VERIFY_SIGNATURE=true

# Production checklist:
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://api.yourdomain.com
# CORS_ALLOWED_ORIGINS=https://app.yourdomain.com
# AI_DRIVER=openai
# QUEUE_CONNECTION=database  (run: php artisan queue:work)

# Platform super-admin created by `php artisan db:seed` (password generated if empty)
OWNER_EMAIL=
OWNER_NAME=
OWNER_PASSWORD=

# Login token lifetime in minutes (default 30 days)
SANCTUM_EXPIRATION=43200

# AI cost limits: messages sent per turn, messages kept, hours before an idle chat restarts
AI_HISTORY_TURNS=20
AI_STORED_MESSAGES=100
AI_CONVERSATION_IDLE_HOURS=24

# Optional: live driving times from the shop to the customer's WhatsApp pin (Google Cloud →
# enable "Routes API" → API key). Empty = each delivery area's fixed time is used.
GOOGLE_MAPS_API_KEY=

# Error alerts (sentry.io → Laravel project → DSN)
SENTRY_LARAVEL_DSN=

# Nightly DB backups to Cloudflare R2 / S3-compatible storage (empty = backups off)
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_KEY=
BACKUP_S3_SECRET=
BACKUP_S3_REGION=auto
