APP_NAME=NeoTalab
APP_ENV=production
APP_KEY=                          # php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://neotalab-api.onrender.com
FRONTEND_URL=https://neotalab.vercel.app

LOG_CHANNEL=stderr
LOG_LEVEL=info

# TiDB Cloud Serverless (MySQL-compatible) or any hosted MySQL
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=4000
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
MYSQL_ATTR_SSL_CA=/etc/ssl/certs/tidb-ca.pem

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database

CORS_ALLOWED_ORIGINS=https://neotalab.vercel.app

AI_DRIVER=fake
OPENAI_API_KEY=

WHATSAPP_APP_SECRET=
WHATSAPP_META_APP_ID=885428047972004
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=1030736913163170
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PLATFORM_ACCESS_TOKEN=
WHATSAPP_GRAPH_VERSION=v21.0
WHATSAPP_VERIFY_SIGNATURE=true

RUN_MIGRATIONS=true
