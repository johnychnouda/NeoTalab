APP_NAME=NeoTalab
APP_ENV=production
APP_KEY=                          # php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://YOUR-API.up.railway.app
FRONTEND_URL=https://YOUR-WEB.up.railway.app

LOG_CHANNEL=stderr
LOG_LEVEL=info

# MySQL 9 (Railway)
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database

CORS_ALLOWED_ORIGINS=https://YOUR-WEB.up.railway.app

AI_DRIVER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=low

WHATSAPP_APP_SECRET=
WHATSAPP_META_APP_ID=885428047972004
# v4 Facebook Login for Business configuration. Meta turns off v2 on 15 October 2026.
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=1030736913163170
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PLATFORM_ACCESS_TOKEN=
WHATSAPP_GRAPH_VERSION=v26.0
WHATSAPP_VERIFY_SIGNATURE=true

RUN_MIGRATIONS=true

# Problem alerts by email: Railway blocks SMTP ports, so use Resend's web API (resend.com)
MAIL_MAILER=resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS=alerts@neotalab.com
MAIL_FROM_NAME=NeoTalab

# Queue service only: workers running side by side (start command: docker/queue.sh)
QUEUE_WORKERS=20

# Optional: live driving times from the shop to the customer's WhatsApp pin (Google Cloud →
# enable "Routes API" → API key). Empty = each delivery area's fixed time is used.
GOOGLE_MAPS_API_KEY=
