# NeoTalab API — Environment Variables
# Copy this to .env and fill in your values

# Server
PORT=8787
NODE_ENV=development

# Database
DATABASE_URL=postgres://neotalab:neotalab@localhost:5432/neotalab

# Auth
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=7d

# WhatsApp Business API (Meta)
WHATSAPP_APP_SECRET=your-meta-app-secret
WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token

# Wish Payment
WISH_API_URL=https://api.wish.com
WISH_API_KEY=your-wish-api-key

# Owner (set on first deploy)
OWNER_EMAIL=johnychnouda@gmail.com
