# Copy to deploy/secrets-for-railway.env (gitignored).
# Paste into Railway → neotalab-api (and the same DB_* on neotalab-queue).
# Prefer referencing the MySQL service instead of typing host/password.

APP_NAME=NeoTalab
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://YOUR-API.up.railway.app
FRONTEND_URL=https://YOUR-WEB.up.railway.app

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database

CORS_ALLOWED_ORIGINS=https://YOUR-WEB.up.railway.app

AI_DRIVER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=low

# Required in production: without it every webhook is rejected (prevents forged messages)
WHATSAPP_APP_SECRET=
WHATSAPP_META_APP_ID=
# Must be a v4 Facebook Login for Business configuration (WhatsApp Embedded Signup).
# Meta turns off v2 configurations on 15 October 2026. A v2 id makes "Connect WhatsApp" fail for new shops.
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PLATFORM_ACCESS_TOKEN=
WHATSAPP_GRAPH_VERSION=v26.0
WHATSAPP_VERIFY_SIGNATURE=true

RUN_MIGRATIONS=true

# Platform super-admin for the one-off `migrate --seed` (password generated + printed if empty)
OWNER_EMAIL=
OWNER_NAME=
OWNER_PASSWORD=

# Login token lifetime in minutes (default 30 days)
SANCTUM_EXPIRATION=43200

# AI cost limits: messages sent per turn, messages kept, hours before an idle chat restarts
AI_HISTORY_TURNS=20
AI_STORED_MESSAGES=100
AI_CONVERSATION_IDLE_HOURS=24

# Problem alerts by email (recipients are set in Owner portal → Settings → Alerts). Railway blocks
# SMTP ports, so email goes through Resend's web API (resend.com → API Keys). Also on the queue service.
MAIL_MAILER=resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS=alerts@neotalab.com
MAIL_FROM_NAME=NeoTalab

# Optional: live driving times from the shop to the customer's WhatsApp pin (Google Cloud →
# enable "Routes API" → API key). Empty = each delivery area's fixed time is used.
GOOGLE_MAPS_API_KEY=

# Optional extra error detail (sentry.io → Laravel project → DSN)
SENTRY_LARAVEL_DSN=

# Nightly DB backups to Cloudflare R2 / S3-compatible storage (empty = backups off)
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_KEY=
BACKUP_S3_SECRET=
BACKUP_S3_REGION=auto
