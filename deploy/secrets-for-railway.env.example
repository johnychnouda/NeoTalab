# Copy to deploy/secrets-for-railway.env (gitignored).
# Paste into Railway → neotalab-api (and the same DB_* on neotalab-queue).
# Prefer referencing the MySQL service instead of typing host/password.

APP_NAME=NeoTalab
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://YOUR-API.up.railway.app
FRONTEND_URL=https://YOUR-WEB.up.railway.app

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database

CORS_ALLOWED_ORIGINS=https://YOUR-WEB.up.railway.app

AI_DRIVER=fake
OPENAI_API_KEY=

WHATSAPP_APP_SECRET=
WHATSAPP_META_APP_ID=
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PLATFORM_ACCESS_TOKEN=
WHATSAPP_GRAPH_VERSION=v21.0
WHATSAPP_VERIFY_SIGNATURE=true

RUN_MIGRATIONS=true
