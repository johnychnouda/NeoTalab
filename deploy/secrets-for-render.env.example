# Copy to deploy/secrets-for-render.env (gitignored) and fill every placeholder.
# Paste the filled file into Render → neotalab-api → Environment.
# See deploy/STEP-BY-STEP.md and backend/.env.production.example.

APP_NAME=NeoTalab
APP_ENV=production
APP_KEY=                          # php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://YOUR-RENDER-SERVICE.onrender.com
FRONTEND_URL=https://YOUR-VERCEL-PROJECT.vercel.app

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=YOUR_TIDB_HOST
DB_PORT=4000
DB_DATABASE=neotalab
DB_USERNAME=YOUR_TIDB_USER
DB_PASSWORD=YOUR_TIDB_PASSWORD
MYSQL_ATTR_SSL_CA=/etc/ssl/certs/tidb-ca.pem

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database

CORS_ALLOWED_ORIGINS=https://YOUR-VERCEL-PROJECT.vercel.app

AI_DRIVER=fake
OPENAI_API_KEY=

WHATSAPP_APP_SECRET=
WHATSAPP_META_APP_ID=
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PLATFORM_ACCESS_TOKEN=
WHATSAPP_GRAPH_VERSION=v21.0
WHATSAPP_VERIFY_SIGNATURE=true

RUN_MIGRATIONS=true
